            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/front_wheel.stl"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/front_wheel.stl"/>
            </geometry>
        </collision>
        <inertial>
            <!-- mass=2 kg, solid cylinder r=0.0425 m, l=0.110 m -->
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="2.0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0"
                     iyy="0.01" iyz="0.0"
                     izz="0.01"/>
        </inertial>
    </link>

    <joint name="front_wheel_left_joint" type="continuous">
        <parent link="front_wheel_shaft_left"/>
        <child link="front_wheel_left"/>
        <origin xyz="0.1488 -0.067 -0.0025435" rpy="0 -0.259 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="5" friction="1"/>
    </joint>


    <!-- ================================================================
         GAZEBO MATERIALS
         ================================================================ -->
         
    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
    </gazebo>
    <gazebo reference="drive_wheel_Ass">
        <material>Gazebo/Yellow</material>
    </gazebo>
    <gazebo reference="drive_wheel">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="caster_wheel_ass_right">
        <material>Gazebo/Yellow</material>
    </gazebo>
    <gazebo reference="caster_wheel_ass_left">
        <material>Gazebo/Yellow</material>
    </gazebo>
    <gazebo reference="caster_wheel_right">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="caster_wheel_left">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="LLt">
        <material>Gazebo/Gray</material>
    </gazebo>
    <gazebo reference="LRt">
        <material>Gazebo/Gray</material>
    </gazebo>
    <gazebo reference="toplidar_back">
        <material>Gazebo/Gray</material>
    </gazebo>
    <gazebo reference="toplidar_front">
        <material>Gazebo/Gray</material>
    </gazebo>
    <gazebo reference="top3dl_link">
        <material>Gazebo/Gray</material>
    </gazebo>
    <gazebo reference="front_lift_link">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="front_wheel_shaft_left">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="front_wheel_shaft_right">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="front_wheel_right">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="front_wheel_left">
        <material>Gazebo/Black</material>
    </gazebo>

    <!-- ================================================================
         GAZEBO FRICTION PROPERTIES
         ================================================================ -->


    <gazebo reference="drive_wheel">
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
    </gazebo>

    <gazebo reference="caster_wheel_left">
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
    </gazebo>

    <gazebo reference="caster_wheel_right">
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
    </gazebo>

    <gazebo reference="front_wheel_left">
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
    </gazebo>

    <gazebo reference="front_wheel_right">
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
    </gazebo>

    <!-- ================================================================
         ROS2 CONTROL PLUGINS AND INTERFACES
         ================================================================ -->

    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        
        <joint name="drive_wheel_Ass_joint">
            <command_interface name="position">
                <param name="min">-1.512</param>
                <param name="max">1.512</param>
            </command_interface> 
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        
        <joint name="drive_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-3.0</param>
                <param name="max">3.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="front_lift_joint">
            <command_interface name="position">
                <param name="min">0.0</param>
                <param name="max">0.095</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
            <parameters>$(find bopt_description)/config/controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>
