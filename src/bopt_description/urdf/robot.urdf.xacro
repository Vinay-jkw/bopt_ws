    </joint>


    <!-- ================================================================
         FRONT LIFT MECHANISM
         ================================================================ -->

    <link name="front_lift_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/front.stl"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/front.stl"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.177 0 0" rpy="0 0 0"/>
            <mass value="25"/>
            <inertia ixx="1.0" ixy="0.0" ixz="0.0"
                     iyy="2.0" iyz="0.0"
                     izz="2.0"/>
        </inertial>
    </link>

    <joint name="front_lift_joint" type="prismatic">
        <parent link="base_link"/>
        <child link="front_lift_link"/>
        <origin xyz="0.477 0 -0.265" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0" upper="0.095" effort="3000" velocity="0.05"/>
        <dynamics damping="50" friction="10"/>
    </joint>


    <!-- ================================================================
         FRONT WHEELS
         ================================================================ -->

    <!-- Front wheel shaft - left -->
    <link name="front_wheel_shaft_left">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/front_wheel_shaft.stl"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <!-- <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/front_wheel_shaft.stl"/>
            </geometry>
        </collision> -->
        <inertial>
            <origin xyz="0.148 0 0" rpy="0 0 0"/>
            <mass value="1"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0"
                     iyy="0.01" iyz="0.0"
                     izz="0.01"/>
        </inertial>
    </link>

    <joint name="front_wheel_shaft_left_joint" type="revolute">
        <parent link="front_lift_link"/>
        <child link="front_wheel_shaft_left"/>

        <origin xyz="0.9190 0.2485 0.0196"
            rpy="0 0.259 0"/>

        <axis xyz="0 1 0"/>

        <limit lower="0"
            upper="0.785"
            effort="50"
            velocity="2"/>  

        <dynamics damping="1.0"
                friction="0.1"/>

        <mimic joint="front_lift_joint"
               multiplier="7.725"
               offset="0"/>
    </joint>


    <!-- Front wheel shaft - right -->
    <link name="front_wheel_shaft_right">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/front_wheel_shaft.stl"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <!-- <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/front_wheel_shaft.stl"/>
            </geometry>
        </collision> -->
        <inertial>
            <origin xyz="0.148 0 0" rpy="0 0 0"/>
            <mass value="1"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0"
                     iyy="0.01" iyz="0.0"
                     izz="0.01"/>
        </inertial>
    </link>

    <joint name="front_wheel_shaft_right_joint" type="revolute">
        <parent link="front_lift_link"/>
        <child link="front_wheel_shaft_right"/>

        <origin xyz="0.9190 -0.1205 0.0196"
            rpy="0 0.259 0"/>

        <axis xyz="0 1 0"/>

        <limit lower="0"
            upper="0.785"
            effort="50"
            velocity="2"/>

        <dynamics damping="1.0"
