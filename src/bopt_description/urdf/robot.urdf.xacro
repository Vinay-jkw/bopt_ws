            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.8"/>
            <inertia ixx="0.02" ixy="0.0" ixz="0.0"
                     iyy="0.02" iyz="0.0"
                     izz="0.02"/>
        </inertial>
    </link>

    <joint name="caster_wheel_joint_right" type="continuous">
        <parent link="caster_wheel_ass_right"/>
        <child link="caster_wheel_right"/>
        <origin xyz="0 0 -0.082835" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="10" friction="6"/>
    </joint>

    <!-- Caster wheel - left -->
    <link name="caster_wheel_left">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/casster_wheel.stl"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
