                     iyy="0.02" iyz="0.0"
                     izz="0.02"/>
        </inertial>
    </link>

    <joint name="caster_wheel_ass_joint_right" type="continuous">
        <parent link="base_link"/>
        <child link="caster_wheel_ass_right"/>
        <origin xyz="0 -0.255 -0.20524" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="1" friction="0.01"/>
    </joint>

    <!-- Caster assembly - left -->
    <link name="caster_wheel_ass_left">
        <visual>
