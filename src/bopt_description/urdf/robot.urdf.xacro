<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bopt_robot">

    <xacro:include filename="materials.xacro"/>

    <!-- ================================================================
         BASE LINKS
         ================================================================ -->

    <link name="base_footprint"/>

    <!-- Base chassis link -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/Base.stl"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/Base.stl"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 -0.2500" rpy="0 0 0"/>
            <mass value="50.0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0"
                     iyy="0.01" iyz="0.0"
                     izz="0.01"/>
        </inertial>
    </link>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.300" rpy="0 0 0"/>
    </joint>

    <!-- ================================================================
         DRIVE WHEEL ASSEMBLY (Steering + Drive)
         ================================================================ -->

    <!-- Drive wheel steering assembly -->
    <link name="drive_wheel_Ass">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/drive_wheel_ass.stl"/>
            </geometry>
            <material name="yellow"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/drive_wheel_ass.stl"/>
            </geometry>
        </collision>
        <inertial>
            <!-- mass=2 kg, box 0.3 x 0.3 x 0.1 m -->
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="2.0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0"
                     iyy="0.01" iyz="0.0"
                     izz="0.01"/>
        </inertial>
    </link>

    <joint name="drive_wheel_Ass_joint" type="revolute">
        <parent link="base_link"/>
        <child link="drive_wheel_Ass"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="1000" velocity="2"/>
        <dynamics damping="5" friction="1"/>
    </joint>

    <!-- Drive wheel -->
    <link name="drive_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/drive_wheel.stl"/>
            </geometry>
            <material name="black"/>
