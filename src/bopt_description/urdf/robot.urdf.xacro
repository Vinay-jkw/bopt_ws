                     iyy="0.02" iyz="0.0"
                     izz="0.02"/>
        </inertial>
    </link>

    <joint name="caster_wheel_joint_left" type="continuous">
        <parent link="caster_wheel_ass_left"/>
        <child link="caster_wheel_left"/>
        <origin xyz="0 0 -0.082835" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="10" friction="6"/>
    </joint>


    <!-- ================================================================
         BOTTOM LIDAR SENSORS (rear corners)
         ================================================================ -->

    <!-- Bottom lidar - left rear -->
    <link name="LLt">
        <visual>
            <origin xyz="0 0 -0.009" rpy="0 0 2.356"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/lidar19.stl"/>
            </geometry>
            <material name="gray"/>
