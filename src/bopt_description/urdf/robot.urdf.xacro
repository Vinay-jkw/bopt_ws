<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bopt_robot">

    <xacro:include filename="materials.xacro"/>
    <xacro:include filename="ros2_control.xacro"/>

    <!-- ================================================================
         BASE LINKS
         ================================================================ -->

    <link name="base_footprint"/>

    <!-- Base chassis link -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/Base.stl"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/Base.stl"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 -0.2500" rpy="0 0 0"/>
            <mass value="80.0"/>
            <inertia ixx="3.46" ixy="0.0" ixz="0.0"
                     iyy="7.73" iyz="0.0"
                     izz="9.06"/>
        </inertial>
    </link>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="-1.542 0 0.337" rpy="0 0 0"/>
    </joint>

    <!-- ================================================================
         DRIVE WHEEL ASSEMBLY (Steering + Drive)
         ================================================================ -->

    <!-- Drive wheel steering assembly -->
    <link name="drive_wheel_Ass">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/drive_wheel_ass.stl"/>
            </geometry>
            <material name="yellow"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/drive_wheel_ass.stl"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="5.0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0"
                     iyy="0.01" iyz="0.0"
                     izz="0.01"/>
        </inertial>
    </link>

    <joint name="drive_wheel_Ass_joint" type="revolute">
        <parent link="base_link"/>
        <child link="drive_wheel_Ass"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="1000" velocity="2"/>
        <dynamics damping="6" friction="0.1"/>
    </joint>

    <!-- Drive wheel -->
    <link name="drive_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/drive_wheel.stl"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.115" length="0.074"/>
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>1.0</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="10.0"/>
            <inertia ixx="0.02" ixy="0.0" ixz="0.0"
                     iyy="0.02" iyz="0.0"
                     izz="0.02"/>
        </inertial>
    </link>

    <joint name="drive_wheel_joint" type="continuous">
        <parent link="drive_wheel_Ass"/>
        <child link="drive_wheel"/>
        <origin xyz="0 0 -0.22315" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="10" friction="6"/>
    </joint>


    <!-- ================================================================
         CASTER WHEEL ASSEMBLIES
         ================================================================ -->

    <!-- Caster assembly - right -->
    <link name="caster_wheel_ass_right">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/caster_wheel_ass.stl"/>
