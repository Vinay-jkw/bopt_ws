            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/drive_wheel.stl"/>
            </geometry>
        </collision>
        <inertial>
            <!-- mass=2.0 kg, solid cylinder r=0.05215 m, l=0.03 m -->
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="2.0"/>
            <inertia ixx="0.02" ixy="0.0" ixz="0.0"
                     iyy="0.02" iyz="0.0"
                     izz="0.02"/>
        </inertial>
    </link>

    <joint name="drive_wheel_joint" type="continuous">
        <parent link="drive_wheel_Ass"/>
        <child link="drive_wheel"/>
        <origin xyz="0 0 -0.222" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="5" friction="2"/>
    </joint>


