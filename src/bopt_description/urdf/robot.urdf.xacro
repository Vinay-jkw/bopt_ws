        </inertial>
    </link>

    <joint name="caster_wheel_ass_joint_left" type="continuous">
        <parent link="base_link"/>
        <child link="caster_wheel_ass_left"/>
        <origin xyz="0 0.255 -0.20524" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="1" friction="0.01"/>
    </joint>

    <!-- Caster wheel - right -->
    <link name="caster_wheel_right">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/jkw/bopt_ws/install/bopt_description/share/bopt_description/meshes/visual/casster_wheel.stl"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
