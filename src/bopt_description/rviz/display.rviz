Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 143
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: true
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        LLt:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        LRt:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        Link Tree Style: Links in Alphabetic Order
        base_footprint:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        caster_wheel_ass_left:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        caster_wheel_ass_right:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        caster_wheel_left:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        caster_wheel_right:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        drive_wheel:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        drive_wheel_Ass:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        front_lift_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        front_wheel_left:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        front_wheel_right:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        front_wheel_shaft_left:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        front_wheel_shaft_right:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        top3dl_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        toplidar_back:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        toplidar_front:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
      Mass Properties:
        Inertia: false
        Mass: false
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
        LLt:
          Value: true
        LRt:
          Value: true
        base_footprint:
          Value: true
        base_link:
          Value: true
        caster_wheel_ass_left:
          Value: true
        caster_wheel_ass_right:
          Value: true
        caster_wheel_left:
          Value: true
        caster_wheel_right:
          Value: true
        drive_wheel:
          Value: true
        drive_wheel_Ass:
          Value: true
        front_lift_link:
          Value: true
        front_wheel_left:
          Value: true
        front_wheel_right:
          Value: true
        front_wheel_shaft_left:
          Value: true
        front_wheel_shaft_right:
          Value: true
        top3dl_link:
          Value: true
        toplidar_back:
          Value: true
        toplidar_front:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        base_footprint:
          base_link:
            LLt:
              {}
            LRt:
              {}
            caster_wheel_ass_left:
              caster_wheel_left:
                {}
            caster_wheel_ass_right:
              caster_wheel_right:
                {}
            drive_wheel_Ass:
              drive_wheel:
                {}
            front_lift_link:
              front_wheel_shaft_left:
                front_wheel_left:
                  {}
              front_wheel_shaft_right:
                front_wheel_right:
                  {}
            top3dl_link:
              {}
            toplidar_back:
              {}
            toplidar_front:
              {}
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_footprint
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8.326075553894043
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.3200003206729889
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 4.83360481262207
    Saved: ~
