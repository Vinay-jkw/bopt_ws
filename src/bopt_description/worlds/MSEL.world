<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.7">
  <world name="warehouse_world">

    <!-- Physics -->
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
        <max_step_size>0.01</max_step_size>
    </physics>

    <!-- Heightmap Ground -->
    <model name="warehouse_ground">
      <static>true</static>
      <include>
        <uri>model://heightmap</uri>
      </include>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- Sun Light -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>

      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>

      <direction>-0.4 0.2 -1</direction>
    </light>

    <!-- Main Warehouse Ceiling Light -->
    <light name="warehouse_light_1" type="point">
      <pose>0 0 12 0 0 0</pose>

      <diffuse>1 1 1 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>

      <attenuation>
        <range>200</range>
        <constant>0.2</constant>
        <linear>0.002</linear>
        <quadratic>0.0001</quadratic>
      </attenuation>

      <cast_shadows>true</cast_shadows>
    </light>

  </world>
</sdf>