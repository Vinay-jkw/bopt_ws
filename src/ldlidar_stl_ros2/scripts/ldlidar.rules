# set the udev rule , make the device_port be fixed by ldlidar
# CP210x USB Device
#KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE:="0777", SYMLINK+="ldlidar"

SUBSYSTEM=="tty", KERNELS=="3-5.6", SYMLINK+="Lidar_L", MODE:="0777"

SUBSYSTEM=="tty", KERNELS=="3-5.3", SYMLINK+="Lidar_LFT", MODE:="0777"

SUBSYSTEM=="tty", KERNELS=="3-5.2", SYMLINK+="Lidar_RFT", MODE:="0777"

SUBSYSTEM=="tty", KERNELS=="3-2", SYMLINK+="Lidar_F", MODE:="0777"

SUBSYSTEM=="tty", KERNELS=="3-1", SYMLINK+="Lidar_NF", MODE:="0777"

SUBSYSTEM=="tty", KERNELS=="3-5.5", SYMLINK+="Lidar_R", MODE:="0777"
