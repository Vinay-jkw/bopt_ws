import rclpy
from rclpy.node import Node
import paho.mqtt.client as mqtt
from std_msgs.msg import String,Bool
from geometry_msgs.msg import PoseStamped
from nav_msgs.msg import Odometry
from rclpy.qos import QoSProfile, ReliabilityPolicy
import json
import time
import os
import subprocess

# MQTT Configuration
MQTT_BROKER =os.getenv('MQTT_BROKER')
MQTT_PORT = 1883
RECONNECT_DELAY = 5  
ROBOT_ID = os.getenv('ROBOT_ID')
ROBOT_IP = os.getenv('ROBOT_IP')

class RosMqttBridge(Node):
    def __init__(self):
        self.task_id=None
        super().__init__('ros_mqtt_bridge')

        # Define QoS profiles
        qos_profile = QoSProfile(reliability=ReliabilityPolicy.RELIABLE, depth=10)
        qos_profile1 = QoSProfile(reliability=ReliabilityPolicy.BEST_EFFORT, depth=10)

        print("Robot ID:", ROBOT_ID)
        print("Robot IP:", ROBOT_IP)

        # Declare ROS parameters for dynamic robot dimensions
        self.declare_parameter("robot_length", 0.45)
        self.declare_parameter("robot_width", 0.45)

        # ROS 2 Subscribers
        self.create_subscription(PoseStamped, 'current_pose', self.pose_callback, qos_profile1)
        self.create_subscription(Odometry, 'odometry/filtered', self.odometry_callback, qos_profile)
        self.create_subscription(String, 'remaining_path', self.remaining_path_callback, qos_profile)
        self.create_subscription(String, f'{ROBOT_ID}/task_request', self.task_request_callback, qos_profile)
        self.create_subscription(String, 'add_nodes', self.add_node_callback, qos_profile)
        self.create_subscription(Bool, f"{ROBOT_ID}/local_path_active", self.local_path_active_callback, qos_profile)

        # ROS 2 Publishers
        # self.safe_exit_pub = self.create_publisher(String, 'Veronica/safe_exit', qos_profile)
        self.task_pub = self.create_publisher(String, f'{ROBOT_ID}/task', qos_profile)
        self.command_pub = self.create_publisher(String, f'{ROBOT_ID}/conflict_action', qos_profile)
        self.task_action_pub = self.create_publisher(String, f'{ROBOT_ID}/task_action', qos_profile)
        self.dimension_pub = self.create_publisher(String, 'robot_dimensions', qos_profile)

        # Timer to periodically publish dimensions (every 5 seconds)
        self.create_timer(5.0, self.dimensions_callback)

        # Initialize MQTT Client with error handling
        self.mqtt_client = mqtt.Client()
        self.mqtt_client.on_connect = self.on_connect
        self.mqtt_client.on_message = self.on_message
        self.mqtt_client.on_disconnect = self.on_disconnect
        self.connect_mqtt()

    def connect_mqtt(self):
        """Attempt to connect to the MQTT broker with a limited retry mechanism."""
        max_retries = 5
        retries = 0

        while retries < max_retries:
            try:
                self.mqtt_client.connect(MQTT_BROKER, MQTT_PORT, 60)
                self.mqtt_client.loop_start()
                self.get_logger().info("Connected to MQTT Broker!")
                return
            except Exception as e:
                retries += 1
                self.get_logger().warn(f"MQTT connection failed: {e}. Retrying in {RECONNECT_DELAY}s...")
                time.sleep(RECONNECT_DELAY)

        self.get_logger().error("Failed to connect to MQTT Broker after multiple attempts.")

    def on_connect(self, client, userdata, flags, rc):
        """Handle MQTT connection events."""
        self.get_logger().info("Connected to MQTT Broker!")
        # Subscribe to required MQTT topics
        client.subscribe(f"{ROBOT_ID}/task")
        client.subscribe(f"{ROBOT_ID}/conflict_action")
        client.subscribe(f"{ROBOT_ID}/task_action")
        

    def on_disconnect(self, client, userdata, rc):
        """Handle MQTT disconnections and attempt reconnection."""
        self.get_logger().warn("MQTT Disconnected! Reconnecting...")
        self.connect_mqtt()

    def on_message(self, client, userdata, msg):
        """Handle incoming MQTT messages and forward them to ROS topics."""
        topic = msg.topic
        payload = msg.payload.decode('utf-8')
        ros_msg = String()
        ros_msg.data = payload


        if topic == f"{ROBOT_ID}/task":
            self.task_pub.publish(ros_msg)
            task_data = json.loads(ros_msg.data)
            
            command_type = task_data.get("command", "")
            path_list = task_data.get("path", [])
            task_list = task_data.get("task", [])
            self.task_id=task_list[0]

            try:
                with open("/home/fbots/bopt_v2_ws/src/workflow_node/workflow_node/path_list.json", "w") as f:
                    json.dump({"path": path_list}, f, indent=4)
                self.get_logger().info("Saved path_list to JSON file.")
            except Exception as e:
                self.get_logger().error(f"Failed to write path_list to file: {e}")

            if command_type == "new_task" and isinstance(task_list, list):
                self.get_logger().info(f"Received task: {task_list}")
                command = ["ros2", "run", "workflow_node", "workflow_node"] + [str(i) for i in task_list]
                self.get_logger().info(f"Executing command: {' '.join(command)}")
                subprocess.Popen(command)
            else:
                self.get_logger().warn("Invalid task format received.")

        elif topic == f"{ROBOT_ID}/conflict_action":
            # Directly publish the conflict action to the ROS topic without waiting for any acknowledgment.
            self.command_pub.publish(ros_msg)

        elif topic == f"{ROBOT_ID}/task_action":
            self.task_action_pub.publish(ros_msg)
            data =payload.strip().split("/")[1]
            if data == "cancel_mna":
                print("task_Action")
                res = subprocess.Popen(f'/usr/bin/bash -c "pgrep -f workflow_node"', shell=True, stdout=subprocess.PIPE)
                pids = [p[:-1].decode() if p[-1] == ord('\n') else p.decode() for p in res.stdout]
                print(pids)

                if len(pids) == 2:
                    commands = [f'kill -SIGRTMIN {pids[1]}', f'kill -SIGRTMIN {pids[0]}']
                else: commands = [f'kill -SIGRTMIN {pids[2]}', f'kill -SIGRTMIN {pids[1]}']
                for command in commands:
                    subprocess.run(f'/usr/bin/bash -c "{command}"', shell=True)
                self.mqtt_client.publish("fms/action_response",f"{ROBOT_IP}/action_response:{ROBOT_ID}=('cancel_mna',{self.task_id})", qos=2)
                # self.task_request_pub = self.create_publisher(String, f'{ROBOT_ID}/task_request', 10)

                print("Movement operation Cancelled successfully.")
                self.task_request_pub.publish(String(data=f"Task Cancelled:{self.task_id}"), qos=2)

    def local_path_active_callback(self, msg: Bool):
        """
        Callback for local path active messages from ROS. This forwards the local
        path active status to the MQTT broker under the topic "Veronica/local_path_active".
        """
        active = msg.data
        # Package the boolean status into JSON. You could also choose to send simply "true"/"false" as text.
        payload = json.dumps({"local_path_active": active})
        self.mqtt_client.publish(f"{ROBOT_ID}/local_path_active", payload)
        # self.get_logger().info(f"Forwarded local_path_active status: {active} to MQTT.")


    def pose_callback(self, msg):
        """Publish the current pose data to the MQTT broker."""
        pose_data = {
            "timestamp": msg.header.stamp.sec + msg.header.stamp.nanosec * 1e-9,
            "position": {
                "x": msg.pose.position.x,
                "y": msg.pose.position.y,
            },
            "orientation": {
                "z": msg.pose.orientation.z,
                "w": msg.pose.orientation.w
            }
        }
        json_payload = json.dumps(pose_data)
        self.mqtt_client.publish(f"{ROBOT_ID}/current_pose", json_payload)

    def task_request_callback(self, msg):
        """Forward ROS task request messages to the MQTT topic."""
        self.get_logger().info(f"Received ROS task request: {msg.data}. Forwarding to MQTT.")
        self.mqtt_client.publish(f"{ROBOT_ID}/task_request", msg.data)
    
    def dimensions_callback(self):
        """Publish robot dimensions to both MQTT and ROS."""
        try:
            length = self.get_parameter("robot_length").value
            width = self.get_parameter("robot_width").value
            dimensions = {"length": length, "width": width}
            json_payload = json.dumps(dimensions)

            self.mqtt_client.publish(f"{ROBOT_ID}/dimensions", json_payload)
            self.dimension_pub.publish(String(data=json_payload))
        except Exception as e:
            self.get_logger().warn(f"Failed to get dimensions: {e}")

    def odometry_callback(self, msg):
        """Publish robot odometry data to the MQTT broker."""
        def clean_value(value):
            return 0.0 if abs(value) < 1e-10 else value

        odometry_data = {
            "timestamp": msg.header.stamp.sec + msg.header.stamp.nanosec * 1e-9,
            "position": {
                "x": msg.pose.pose.position.x,
                "y": msg.pose.pose.position.y,
                "z": msg.pose.pose.position.z,
            },
            "orientation": {
                "x": msg.pose.pose.orientation.x,
                "y": msg.pose.pose.orientation.y,
                "z": msg.pose.pose.orientation.z,
                "w": msg.pose.pose.orientation.w
            },
            "velocity": {
                "linear_x": clean_value(msg.twist.twist.linear.x),
                "linear_y": clean_value(msg.twist.twist.linear.y),
                "angular_z": clean_value(msg.twist.twist.angular.z),
            },
            "pose_covariance": [clean_value(value) for value in msg.pose.covariance],
            "twist_covariance": [clean_value(value) for value in msg.twist.covariance]
        }

        json_payload = json.dumps(odometry_data)
        self.mqtt_client.publish(f"{ROBOT_ID}/odometry", json_payload)

    def remaining_path_callback(self, msg):
        """Publish remaining path information to the MQTT broker."""
        remaining_path_data = {
            "timestamp": time.time(),
            "remaining_path": msg.data.split(",")  # Convert comma-separated string to list
        }
        json_payload = json.dumps(remaining_path_data)
        self.mqtt_client.publish(f"{ROBOT_ID}/remaining_path", json_payload)

    def add_node_callback(self, msg):
        """
        Callback for messages arriving on the ROS side for the add_nodes topic.
        These messages are forwarded to the MQTT topic Veronica/add_nodes.
        """
        # self.get_logger().info(f"Received add_nodes message on ROS: {msg.data}. Forwarding to MQTT.")
        self.mqtt_client.publish(f"{ROBOT_ID}/add_nodes", msg.data)

def main():
    rclpy.init()
    node = RosMqttBridge()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        node.get_logger().info("Shutting down ROS-MQTT Bridge")
    finally:
        node.mqtt_client.loop_stop()
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()