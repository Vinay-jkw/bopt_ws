    def fetch_location_data_from_db(self):
        # Path to the SQLite database file
        db_path = '/home/jkw/bopt_ws/src/workflow_node/map_details/Simulation_Map_wn.db' # '/home/jkw/bopt_ws/src/workflow_node/map_details/testing_ground_wn.db'
        # Connect to the SQLite database
        conn = sqlite3.connect(db_path)

        # Queries to fetch all data from the specified tables
        queries = {
            'left_easy_dock': 'SELECT * FROM left_easy_dock;',
            'right_easy_dock': 'SELECT * FROM right_easy_dock;',
            'dock_location': 'SELECT * FROM dock_location;',
            'dock_station_end_line': 'SELECT * FROM dock_station_end_line;'
        }

        # Dictionary to store the data from each table
        dataframes = {}

        # Execute each query and store the results in a DataFrame
        for table_name, query in queries.items():
            dataframes[table_name] = pd.read_sql(query, conn)
        print(dataframes)

        # Execute each query and store the results in a DataFrame
        for table_name, query in queries.items():
            dataframes[table_name] = pd.read_sql(query, conn)

        # Function to convert DataFrame to desired dictionary
        def create_location_dict(df, name_col, coord_cols):
            return df.set_index(name_col)[coord_cols].apply(lambda row: row.tolist(), axis=1).to_dict()

        # 1. left_easy_dock
        left_easy_dock_dict = create_location_dict(
            dataframes['left_easy_dock'],
            name_col='easy_dock_name',
            coord_cols=['x', 'y', 'z', 'W']
        )

        # 2. right_easy_dock
        right_easy_dock_dict = create_location_dict(
            dataframes['right_easy_dock'],
            name_col='easy_dock_name',
            coord_cols=['x', 'y', 'z', 'W']
        )

        # 3. dock_location
        dock_location_dict = create_location_dict(
            dataframes['dock_location'],
            name_col='dock_name',
            coord_cols=['x_m', 'y_m', 'pose_z', 'pose_w']
        )

        # 4. dock_station_end_line
        dock_station_end_line_dict = create_location_dict(
            dataframes['dock_station_end_line'],
            name_col='station_name',
            coord_cols=['station_x', 'station_y', 'pose_z', 'pose_w']
        )

        # Close the database connection
        conn.close()
        return left_easy_dock_dict, right_easy_dock_dict, dock_location_dict, dock_station_end_line_dict


    def current_pose_callback(self, msg):
        self.current_pose = msg.pose.position.x, msg.pose.position.y, msg.pose.orientation.z, msg.pose.orientation.w



    def publish_holded_nodes(self):
        if cancel_status or stop_event.is_set(): return
        current_pose = self.current_pose
        if current_pose is None:
            return
        x = self.waypoints_positions[:, 0]
        y = self.waypoints_positions[:, 1]
        *_, theta = self.quaternion_to_euler(current_pose[3], 0, 0, current_pose[2])
        # Use parallel mask function
        mask = rotated_rectangle_mask(x, y, current_pose[0], current_pose[1], (0.4, 2.5), (1.0, 1.0), theta+np.pi)

        # Filter nodes
        matching_nodes = self.waypoints[mask]

        self.holded_nodes_publisher.publish(String(data=json.dumps({'holded_nodes': matching_nodes.tolist()})))

    def conflict_action_msg_handler(self, msg):
        try:
            conflict_action = json.loads(msg.data)
            if self.nmpc_fast_process is None:
                self.reroutor_startup_conflict = msg
            else:
                if conflict_action['type'] == "reroute":
                    print("Reroute command received:", conflict_action)
                    self.moving_to_destination = False
                    self.reroute_locations = deque(conflict_action['data'])
                    # if self.is_halted: self.is_halted = False
                    # else:
                    if self.nmpc_fast_process.poll() is None:
                        os.killpg(os.getpgid(self.nmpc_fast_process.pid), signal.SIGINT)
                    self.nmpc_fast_process.kill()
                    # self.nmpc_fast_process.wait()
                    # self.nmpc_fast_process = None
                elif conflict_action['type'] == "halt" and self.nmpc_fast_process.poll() is None: #and not self.is_halted:
                    print("Halt command received:", conflict_action)
                    param_cli = self.create_client(
                        SetParameters,
                        '/robot_client/set_parameters'
                    )

                    while not param_cli.wait_for_service(timeout_sec=1.0):
                        self.get_logger().info('Waiting for parameter service...')
                    # if not param_cli.service_is_ready():
                    #     self.get_logger().warn('Parameter service not ready')
                    #     return

                    req = SetParameters.Request()
                    req.parameters = [
                        Parameter('should_halt', value=True).to_parameter_msg()
                    ]

                    param_cli.call_async(req)
                    # self.moving_to_destination = False
                    # if self.nmpc_fast_process.poll() is None:
                    #     os.killpg(os.getpgid(self.nmpc_fast_process.pid), signal.SIGINT)
                    # self.nmpc_fast_process.kill()
                    # self.is_halted = True
                elif conflict_action['type'] == "resume" and self.nmpc_fast_process.poll() is None: #and self.is_halted:
                    print("Resume command received:", conflict_action)
                    param_cli = self.create_client(
                        SetParameters,
                        '/robot_client/set_parameters'
                    )

                    while not param_cli.wait_for_service(timeout_sec=1.0):
                        self.get_logger().info('Waiting for parameter service...')
                    # if not param_cli.service_is_ready():
                    #     self.get_logger().warn('Parameter service not ready')
                    #     return

                    req = SetParameters.Request()
                    req.parameters = [
                        Parameter('should_halt', value=False).to_parameter_msg()
                    ]

                    param_cli.call_async(req)
                    # if self.current_reroute_item is not None:
                    #     if isinstance(self.current_reroute_item[0], (float, int)):
                    #         self.reroute_locations.appendleft(self.current_reroute_item)
