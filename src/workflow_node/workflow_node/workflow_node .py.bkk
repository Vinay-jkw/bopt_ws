    def is_movement_needed(self):
        gap_from_dock = self.euclidean_distance(get_current_pose(), self.dock_location)
        print('GFD',gap_from_dock)
        if gap_from_dock > 0.2:
            return True
        else:
            return False

    def is_near_location(self, location, dist_threshold=1.0):
        current_pose = get_current_pose()
        radius = dist_threshold # 1
        # self.parking = [10.4675, 10.5192, 0.999999239762975, 0.00123307480405663] # this is end_of_line of Parking1
        # self.parking2 = [10.512, 11.9436, -0.999987199697188, 0.0010596879129085] # this is end of line of Parking2 on Nov 11.

        dist=math.hypot(current_pose[0] - location[0], current_pose[1] - location[1])
        print("distance is: ", dist)
        if dist <= radius:
            return True
        return False

